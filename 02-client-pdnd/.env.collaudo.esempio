# Configurazione per l'ambiente di COLLAUDO PDND.
# Copia questo file in ".env.collaudo", compila i valori dal back office e usa:
#   python chiama_eservice.py <percorso> --env .env.collaudo
#
# Dove trovare i valori (back office PDND di collaudo, area Fruizione):
#   - Client ID: nella pagina del client e-service
#   - KID: nella lista delle chiavi pubbliche del client, dopo aver caricato chiavi/pubblica.pem
#   - Purpose ID: nella pagina della finalità (deve essere attiva e associata al client)
#   - Endpoint e audience: nella pagina del client c'è la guida al voucher con i
#     valori aggiornati; quelli qui sotto sono quelli noti per il collaudo.
#   - ESERVICE_URL: indirizzo del server dell'erogatore (dalla scheda dell'e-service
#     o dalla sua interfaccia OpenAPI).

PDND_CLIENT_ID=
PDND_KID=
PDND_PURPOSE_ID=
PDND_CHIAVE_PRIVATA=chiavi/privata.pem
PDND_TOKEN_URL=https://auth.uat.interop.pagopa.it/token.oauth2
PDND_AUDIENCE=auth.uat.interop.pagopa.it/client-assertion
ESERVICE_URL=
